# Copy to .env (`cp .env.example .env`) and fill in. .env is gitignored and loaded on start.
# PaidYet starts without TELEGRAM_BOT_TOKEN or SENTRY_DSN: it skips the bot or runs without Sentry.

# Bot token from @BotFather in Telegram: send /newbot, choose a name and a username ending in "bot".
TELEGRAM_BOT_TOKEN=

# Sentry DSN: in Sentry, open your Python project > Settings > Client Keys (DSN). Leave empty to run without Sentry.
SENTRY_DSN=

# Your own Telegram user ID. Start the bot and send /start: it replies with your ID.
ADMIN_USER_ID=

# Who may use the bot: comma-separated name:telegram_id pairs. Add yourself too; your name here is
# what friends see in "added by <name>". Friends get their ID by sending /start to the bot.
# Example: me:111111111,arjun:222222222
ALLOWED_USERS=

# Gemma model in Ollama. `poe up` pulls it if missing. gemma4:e2b suits machines with less memory.
OLLAMA_MODEL=gemma4:e4b

# Where Ollama listens. Must stay on 127.0.0.1: bills are only ever read by the local model.
OLLAMA_HOST=127.0.0.1:11434

# Runtime data: SQLite, Temporal history, temporary photos, logs, pid files. Gitignored.
PAIDYET_DATA_DIR=.data

# Time zone for reading and showing due dates.
TZ=Asia/Kolkata
